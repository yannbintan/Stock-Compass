{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "stock-compass",
  "main": "worker/index.ts",
  "compatibility_date": "2026-04-01",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "assets": { "binding": "ASSETS", "directory": "./public" },
  "vars": { "ALPACA_DATA_FEED": "iex" }
}
